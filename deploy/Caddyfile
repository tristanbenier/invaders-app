# /etc/caddy/Caddyfile — set INVADERS_DOMAIN in /etc/default/caddy (see deploy/README.md).
# Caddy obtains and renews the HTTPS certificate automatically.
{$INVADERS_DOMAIN} {
	encode zstd gzip

	# Vue build and icons, collected by `manage.py collectstatic`.
	handle_path /static/* {
		root * /srv/invaders/backend/staticfiles
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Uploaded photos (random, unguessable file names).
	handle /media/* {
		root * /srv/invaders/backend
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else: Django (pages, API, admin, map tiles, service worker).
	handle {
		reverse_proxy 127.0.0.1:8001
	}

	log {
		output file /var/log/caddy/invaders.log
	}
}
