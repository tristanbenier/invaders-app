# /etc/systemd/system/invaders.service
[Unit]
Description=Invaders (Django + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=invaders
Group=invaders
WorkingDirectory=/srv/invaders/backend
ExecStart=/srv/invaders/backend/.venv/bin/gunicorn -c gunicorn.conf.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening: only the app and backup directories are writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/invaders /srv/invaders-backups

[Install]
WantedBy=multi-user.target
