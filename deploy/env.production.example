# /srv/invaders/.env on the production server (owner invaders, chmod 600).
DJANGO_SETTINGS_MODULE=config.settings
# python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=invaders.example.org
CSRF_TRUSTED_ORIGINS=https://invaders.example.org
FRONTEND_URL=https://invaders.example.org
DJANGO_VITE_DEV_MODE=False
# Raise to 31536000 (one year) once HTTPS works.
SECURE_HSTS_SECONDS=3600

DATABASE_URL=sqlite:////srv/invaders/backend/db.sqlite3

# Identify the app to OpenStreetMap services; put a way to contact you.
GEOCODER_USER_AGENT=Invaders/1.0 (+https://invaders.example.org; you@example.org)
TILE_CACHE_MAX_DAYS=7

VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
