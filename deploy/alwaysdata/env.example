# ~/invaders/.env on alwaysdata (chmod 600). Replace "moncompte" with the account name.
DJANGO_SETTINGS_MODULE=config.settings
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=moncompte.alwaysdata.net
CSRF_TRUSTED_ORIGINS=https://moncompte.alwaysdata.net
FRONTEND_URL=https://moncompte.alwaysdata.net
DJANGO_VITE_DEV_MODE=False
# Raise to 31536000 (one year) once HTTPS works.
SECURE_HSTS_SECONDS=3600

# No Caddy: Django serves /static/ and /media/, and the visitor's IP comes from the header
# set by alwaysdata's proxy (its documented headers: X-Real-IP and X-Forwarded-Proto).
SERVE_FILES=True
CLIENT_IP_HEADER=X-Real-IP
NUM_PROXIES=0

# Empty = backend/db.sqlite3 (the path deploy/backup.sh backs up).
DATABASE_URL=

# Identify the app to OpenStreetMap services; put a way to contact you.
GEOCODER_USER_AGENT=Invaders/1.0 (+https://moncompte.alwaysdata.net; you@example.org)
# 1 GB of disk: keep the map tile cache small.
TILE_CACHE_MAX_DAYS=3

VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
