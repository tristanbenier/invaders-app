# Project-wide configuration, loaded by the backend (and later the frontend).
# Copy to .env and fill in. Values here override variables exported in the shell.

# Django
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Vue app: True = scripts from the Vite dev server (`npm run dev`, hot reload),
# False = built files (`npm run build`). Defaults to DEBUG.
DJANGO_VITE_DEV_MODE=True

# Database
DATABASE_URL=postgres:///invaders

# Public URL of the site (Django serves the Vue app), used in invitation links
FRONTEND_URL=http://localhost:8000

# Identifying User-Agent sent to Nominatim (reverse geocoding); add a contact, e.g. an email.
GEOCODER_USER_AGENT=Invaders/1.0 (team map for Space Invaders)

# Frontend (only VITE_* variables are exposed to the browser)
# Map tiles; defaults to the standard OpenStreetMap tiles when empty.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
